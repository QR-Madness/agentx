---
import bundleUrl from 'redoc/bundles/redoc.standalone.js?url';
import ExplorerLayout from '../../layouts/ExplorerLayout.astro';
import { slugToHref } from '../../config/nav';
---

<ExplorerLayout
  title="Interactive Explorer"
  description="Interactive OpenAPI explorer for the AgentX REST API."
  backHref={slugToHref('api/endpoints')}
  backLabel="API Endpoints"
>
  {/* Redoc 3 reads options as kebab-case attributes. scroll-y-offset keeps anchor
      targets clear of the sticky header above; disable-telemetry turns off the
      usage data Redoc 3 otherwise sends to Redocly (it accepts only "true"). */}
  <redoc spec-url="/openapi.yaml" scroll-y-offset="60" disable-telemetry="true"></redoc>
  {/* The Redoc 3 standalone bundle is an ES module. */}
  <script is:inline type="module" src={bundleUrl}></script>
</ExplorerLayout>
